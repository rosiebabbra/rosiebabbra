{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Yarn Start",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "/opt/homebrew/bin/yarn",
            "runtimeArgs": [
                "start"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}